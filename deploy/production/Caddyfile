# Caddy - public HTTPS entry, reverse proxy to internal api + web
# The web (Next.js) and api (FastAPI) run in the same all-in-one image,
# but Caddy remains the only host-port 80/443 listener (defense in depth).

{
	admin off
	email {$ACME_EMAIL:tls@reliastra.com}
}

# Production site - adapt domain
{$DOMAIN:reliastra.com} {
	# Security headers - minimal, non-breaking
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	encode gzip

	# Partner referral links (`/r/{code}`) MUST stay on the Next.js catch-all
	# below. The App Router resolver Set-Cookies on reliastra.com and 302s
	# into the signup/landing flow. Do NOT proxy `/r/*` to FastAPI: the API
	# lives at `/v1/public/referral/{code}` and a cookie set on a different
	# hop would not attribute the visitor. Invalid codes are handled by
	# Next.js (`/referral-unavailable`), never the generic 404.

	# Frontend - Next.js standalone
	handle {
		reverse_proxy reliastra-api:3000 {
			header_up Host {host}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# NOTE: there is intentionally NO `handle /api/*` block. All /api/*
	# traffic goes to Next.js (catch-all above), whose /api/* route
	# handlers proxy to the backend with cookie->header auth re-injection
	# (see frontend/src/lib/backend-proxy.ts). A direct `handle /api/* ->
	# api:8000` would shadow those routes AND 404, because the backend
	# serves /v1/*, not /api/v1/*. Direct backend consumers use /v1/*,
	# /health*, /openapi.json* and /api-docs* below.
	handle /v1/* {
		reverse_proxy reliastra-api:8000
	}
	handle /health* {
		reverse_proxy reliastra-api:8000
	}
	handle /metrics* {
		reverse_proxy reliastra-api:8000
	}
	handle /openapi.json* {
		reverse_proxy reliastra-api:8000
	}
	# Interactive API consoles. FastAPI is configured with docs_url="/api-docs"
	# and redoc_url="/api-redoc" (see backend/app/bootstrap/app_factory.py), so
	# these two prefixes - and ONLY these two - belong to the backend.
	handle /api-docs* {
		reverse_proxy reliastra-api:8000
	}
	handle /api-redoc* {
		reverse_proxy reliastra-api:8000
	}

	# ── The public documentation namespace, claimed positively ──────────────
	# `/docs` and `/docs/*` are the product documentation: thirteen indexable
	# pages built from frontend/src/lib/docs/corpus.ts and published in
	# sitemap.xml. They must be rendered by Next.js.
	#
	# This block exists so the claim is an executable rule rather than a
	# comment. Leaving `/docs` to fall through to the catch-all below is
	# correct but silent: a stale or hand-edited Caddyfile that proxies
	# `/docs*` to :8000 reclaims the whole namespace for FastAPI, which serves
	# no `/docs` route at all and answers every one of the thirteen pages with
	# `404 {"code":"RESOURCE_NOT_FOUND"}`. That reads as a working site (the
	# landing, console and API all stay up) while every documentation URL - and
	# every "Docs" link in the nav - dead-ends into raw JSON.
	#
	# Do NOT merge this into the /api-docs block above, and do not delete it in
	# favour of the catch-all. `deploy/production/scripts/smoke-test.sh` and
	# `frontend/src/lib/__tests__/docs-namespace-routing.test.ts` both fail if
	# this namespace stops rendering.
	handle /docs* {
		reverse_proxy reliastra-api:3000 {
			header_up Host {host}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	log {
		output stdout
		format json
	}
}

# Redirect www → apex
www.{$DOMAIN:reliastra.com} {
	redir https://{$DOMAIN:reliastra.com}{uri} permanent
}

# Caddy - public HTTPS entry, reverse proxy to internal api + web
# The web (Next.js) and api (FastAPI) run in the same all-in-one image,
# but Caddy remains the only host-port 80/443 listener (defense in depth).

{
	admin off
	email {$ACME_EMAIL:tls@reliastra.com}
}

# Production site - adapt domain
{$DOMAIN:reliastra.com} {
	# Security headers - minimal, non-breaking
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	encode gzip

	# Partner referral links (`/r/{code}`) MUST stay on the Next.js catch-all
	# below. The App Router resolver Set-Cookies on reliastra.com and 302s
	# into the signup/landing flow. Do NOT proxy `/r/*` to FastAPI: the API
	# lives at `/v1/public/referral/{code}` and a cookie set on a different
	# hop would not attribute the visitor. Invalid codes are handled by
	# Next.js (`/referral-unavailable`), never the generic 404.

	# Frontend - Next.js standalone
	handle {
		reverse_proxy reliastra-api:3000 {
			header_up Host {host}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# NOTE: there is intentionally NO `handle /api/*` block. All /api/*
	# traffic goes to Next.js (catch-all above), whose /api/* route
	# handlers proxy to the backend with cookie->header auth re-injection
	# (see frontend/src/lib/backend-proxy.ts). A direct `handle /api/* ->
	# api:8000` would shadow those routes AND 404, because the backend
	# serves /v1/*, not /api/v1/*. Direct backend consumers use /v1/*,
	# /health* and /metrics* below.
	handle /v1/* {
		reverse_proxy reliastra-api:8000
	}
	handle /health* {
		reverse_proxy reliastra-api:8000
	}
	handle /metrics* {
		reverse_proxy reliastra-api:8000
	}

	# ── The API schema is deliberately NOT proxied ───────────────────────────
	# /openapi.json, /api-docs and /api-redoc are intentionally absent from this
	# file. Do not add them back.
	#
	# The schema enumerates every registered route, including the authenticated
	# ones: /v1/billing/*, /v1/api-keys/*, the admin control plane and
	# /v1/evidence/{report_token}/download. Serving it unauthenticated turns one
	# GET into a complete attack-surface map, and the snapshot is committed
	# nowhere public either.
	#
	# Two independent layers guard this:
	#   1. EXPOSE_API_SCHEMA defaults to False in backend/app/config.py, which
	#      makes FastAPI register no schema route at all.
	#   2. This proxy, which does not forward the paths even if layer 1 is
	#      misconfigured in production.
	#
	# Keep both. A layer that only exists in application config is one env
	# variable away from being off in the wrong direction.
	#
	# `frontend/src/lib/__tests__/docs-namespace-routing.test.ts` asserts this
	# file does NOT claim these prefixes. If you are re-adding them, delete that
	# assertion in the same commit and justify it.

	# ── The public documentation namespace, claimed positively ──────────────
	# `/docs` and `/docs/*` are the product documentation: thirteen indexable
	# pages built from frontend/src/lib/docs/corpus.ts and published in
	# sitemap.xml. They must be rendered by Next.js.
	#
	# This block exists so the claim is an executable rule rather than a
	# comment. Leaving `/docs` to fall through to the catch-all below is
	# correct but silent: a stale or hand-edited Caddyfile that proxies
	# `/docs*` to :8000 reclaims the whole namespace for FastAPI, which serves
	# no `/docs` route at all and answers every one of the thirteen pages with
	# `404 {"code":"RESOURCE_NOT_FOUND"}`. That reads as a working site (the
	# landing, console and API all stay up) while every documentation URL - and
	# every "Docs" link in the nav - dead-ends into raw JSON.
	#
	# Do NOT merge this into a backend block, and do not delete it in
	# favour of the catch-all. `deploy/production/scripts/smoke-test.sh` and
	# `frontend/src/lib/__tests__/docs-namespace-routing.test.ts` both fail if
	# this namespace stops rendering.
	handle /docs* {
		reverse_proxy reliastra-api:3000 {
			header_up Host {host}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	log {
		output stdout
		format json
	}
}

# ── API host ───────────────────────────────────────────────────────────────
# `api.reliastra.com` is the documented API origin and the hardcoded default
# of the shipped CLI (cli/cmd/reliastra/config.go: defaultAPIURL). DNS for it
# has always pointed at this host, but it never had a site block here.
#
# That gap is a hard TLS failure, not a 404. Caddy issues certificates only
# for the server names present in its configuration, and it does not perform
# on-demand TLS unless `on_demand_tls` is configured. A ClientHello for
# api.reliastra.com therefore matched no site and no certificate, so Caddy
# aborted the handshake with `tlsv1 alert internal error` (alert 80) before
# sending any certificate at all. It also contradicted the apex HSTS
# directive above, which sets `includeSubDomains` and therefore requires
# every subdomain - api included - to present valid TLS.
#
# The apex site deliberately does not cover this host: Caddy matches
# certificates by exact server name, so `reliastra.com` never covers
# `api.reliastra.com`.
#
# Every request on this host goes to the FastAPI backend. There is no
# Next.js in this path: the marketing site, dashboard and documentation are
# served from the apex, and Next.js reaches the backend through its own
# /api/* route handlers. The backend serves /v1/*, /health and /metrics; the
# schema paths are refused above; any other path correctly 404s as JSON.
api.{$DOMAIN:reliastra.com} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	encode gzip

	# ── The API schema is refused here, explicitly ──────────────────────────
	# This site block proxies everything to the backend, so without these the
	# schema is reachable here even when the app does not register the route:
	# an accidental `EXPOSE_API_SCHEMA=true` in .env.production would publish
	# all 186 routes from the API host, which is the single host an attacker
	# would try first.
	#
	# `abort` closes the connection without reaching the upstream. 404 would
	# also work, but an explicit refusal cannot be confused with a route that
	# happens to be missing.
	handle /openapi.json* {
		abort
	}
	handle /api-docs* {
		abort
	}
	handle /api-redoc* {
		abort
	}

	handle {
		reverse_proxy reliastra-api:8000 {
			header_up Host {host}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	log {
		output stdout
		format json
	}
}

# Redirect www → apex
www.{$DOMAIN:reliastra.com} {
	redir https://{$DOMAIN:reliastra.com}{uri} permanent
}

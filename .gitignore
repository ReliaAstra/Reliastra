# ── Node / Next.js (frontend) ──────────────────────────────────────────
node_modules/
.next/
out/
dist/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Python (backend) ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
.venv-test/
venv/
ENV/
*.egg-info/
*.egg
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# ── Environment ───────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Build / cache ─────────────────────────────────────────────────────
coverage/
.cache/
tmp/
.turbo/
.parcel-cache/

# ── IDE ───────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Docker / Vercel / TypeScript ──────────────────────────────────────
.docker/
.vercel
*.tsbuildinfo
next-env.d.ts

# ── CLI distribution (built by GoReleaser / npm pack / python -m build) ──
# Release artifacts are produced by CI and attached to the GitHub release;
# only the source that produces them is committed.
cli/npm/*.tgz
cli/python/build/
cli/python/dist/
cli/python/src/*.egg-info/

# ── Backend runtime ───────────────────────────────────────────────────
backend/*.db
backend/*.sqlite3
celerybeat-schedule
# Beat keeps its live schedule in SQLite sidecars; the bare name above does
# not match them, and they are recreated on every boot.
celerybeat-schedule-wal
celerybeat-schedule-shm
celerybeat.pid
logs/

# ── Frontend project-specific ─────────────────────────────────────────
local-*
.claude
.z-ai-config
/skills/tool-results/

# Frontend local artifacts - never committed (SQLite dev DB, agent scratch,
# stray screenshots). The Prisma layer is retired except the one-shot
# backfill script; its dev database must never be committed.
frontend/db/
frontend/tool-results/
frontend/download/
*.db
*.sqlite3

# Arena sandbox harness (browser builds, scratch DB) - never shipped
.arena/

# Local dev-stack state (postgres cluster, redis, logs) - never committed
backend/.dev-stack/

# ── Visual QA artefacts (rendered screenshots, local only) ────────────
frontend/.qa/
frontend/test-results/
frontend/playwright-report/
# Browser-automation scratch: page snapshots, console logs, trace output.
.playwright-mcp/

# ── Graphify knowledge graph (local, regenerable) ─────────────────────
# ~55MB of derived JSON rebuilt by `graphify extract . --code-only`.
# A rebuild is cheaper than a merge conflict on a derived artifact. Opt in
# deliberately with:  git add -f graphify-out/graph.json
graphify-out/

# Syndication rasters: generated by export-figures.mjs --png for platforms
# that will not host an SVG. Not artifacts of record; the SVGs are.
research/*/figures/syndication/

# ── CLI release packaging (generated by goreleaser / python -m build) ─
# dist/ is already ignored above (covers /dist and cli/python/dist);
# these are the other local artifacts a dry run leaves behind.
cli/python/build/
cli/python/src/*.egg-info/
cli/npm/*.tgz
# `make cli` / `go build` in cli/ drops the binary beside the module
/cli/reliastra
/cli/reliastra.exe

# Production host addresses. Public repo: never commit a real tailnet or origin IP.
deploy/production/.host.local
**/.host.local

# API schema snapshot. Public repo: the OpenAPI document enumerates every
# authenticated route, so a committed copy is an attack-surface disclosure.
# Generate locally with: EXPOSE_API_SCHEMA=true python -m scripts.export_openapi
backend/docs/openapi.json

# Reliastra frontend - local environment
# Copy to .env and adjust if needed.
# Do not commit real secrets.

# Prisma SQLite used by the Next.js partner-network demo data.
# The committed db/custom.db is local/dev data from the original Frontend repo.
DATABASE_URL="file:./db/custom.db"

# Production Reliastra API (used by Next.js server-side partner proxy).
# Paths are appended as /v1/...
RELIASTRA_API_URL="https://api.reliastra.com"

# Reader token for the public dependency-index reads (lib/track-api). Server-side
# only; never NEXT_PUBLIC_. MUST equal the backend's INTERNAL_READER_TOKEN.
# Without it, every server-side read of the catalog, of /observatory/{vendor},
# and of the sitemap shares one anonymous per-IP rate-limit bucket with the
# browser traffic this app proxies - a single crawler walking the index can 429
# the reads that render the pages it is walking. Generate a strong random value:
#   openssl rand -hex 32
RELIASTRA_READER_TOKEN=""

# Per-request timeout for measurement-API reads, in milliseconds (default 8000).
# A read that exceeds it throws, which is what makes the page fail loudly
# instead of publishing an empty index as though nothing existed.
RELIASTRA_API_TIMEOUT_MS=8000

# Canonical origin of this deployment. Drives canonical URLs, sitemap.xml,
# robots.txt, and the indexability check below.
NEXT_PUBLIC_SITE_URL="https://reliastra.com"

# Set to "false" on any deployment that must not be indexed (staging, preview).
# Overrides the host check in either direction; "true" forces indexing even on a
# non-production host. Any other value is ignored and the host decides.
NEXT_PUBLIC_SITE_INDEXABLE=

# Admin control-plane secret. MUST be the same value as the backend's
# ADMIN_TOKEN_SECRET. Used ONLY server-side by the Next proxy (proxy.ts) and
# the /api/admin/* route handlers to verify the HttpOnly admin session
# cookies. Never exposed to the browser. Generate a strong random value:
#   openssl rand -hex 32
ADMIN_TOKEN_SECRET=""
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=15
ADMIN_REFRESH_TOKEN_EXPIRE_DAYS=1

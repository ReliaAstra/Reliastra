# Reliastra frontend — local environment
# Copy to .env and adjust if needed.
# Do not commit real secrets.

# Prisma SQLite used by the Next.js partner-network demo data.
# The committed db/custom.db is local/dev data from the original Frontend repo.
DATABASE_URL="file:./db/custom.db"

# Production Reliastra API (used by Next.js server-side partner proxy).
# Paths are appended as /v1/...
RELIASTRA_API_URL="https://api.reliastra.com"

# Reliastra frontend — local environment
# Copy to .env and adjust if needed.
# Do not commit real secrets.

# Prisma SQLite used by the Next.js partner-network demo data.
# The committed db/custom.db is local/dev data from the original Frontend repo.
DATABASE_URL="file:./db/custom.db"

# Production Reliastra API (used by Next.js server-side partner proxy).
# Paths are appended as /v1/...
RELIASTRA_API_URL="https://api.reliastra.com"

# Admin control-plane secret. MUST be the same value as the backend's
# ADMIN_TOKEN_SECRET. Used ONLY server-side by the Next proxy (proxy.ts) and
# the /api/admin/* route handlers to verify the HttpOnly admin session
# cookies. Never exposed to the browser. Generate a strong random value:
#   openssl rand -hex 32
ADMIN_TOKEN_SECRET=""
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=15
ADMIN_REFRESH_TOKEN_EXPIRE_DAYS=1

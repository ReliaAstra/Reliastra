# =============================================================================
# Reliastra Backend — Environment Configuration
# =============================================================================

# ── CORE SERVICES (Required) ──────────────────────────────────────────────────
# Supabase Postgres connection URL with the asyncpg driver (REQUIRED).
# Copy from Supabase → Project Settings → Database.
# Prefer the connection pooler (port 6543) for the API and workers.
# Example:
#   postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres

# PostgreSQL SSL mode. Supabase URLs default to 'require' when this is empty.
# Supported: disable | allow | prefer | require | verify-ca | verify-full.
DATABASE_SSL_MODE=require

# Redis connection URL (REQUIRED for rate limiting, idempotency, Celery, OAuth state).
# Redis is a cache/queue only — application data lives on Supabase.
REDIS_URL=redis://localhost:6379/0

# Cryptographic secret key for JWT signing and Fernet encryption (REQUIRED)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-cryptographically-random-32-char-string

# Environment name: development | staging | production
ENVIRONMENT=development

# Structured JSON logs (always on in production). Set true to force JSON locally.
LOG_JSON=false

# Celery Beat interval for dispatching due dependency checks (seconds)
CHECK_SCHEDULE_SECONDS=30

# Celery task time limits (seconds)
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_TASK_TIME_LIMIT=300

# ── CORS (Required for frontend integration) ───────────────────────────────────
# Must include your frontend URL(s). The default allows local dev only.
# For production: ["https://yourdomain.com", "https://app.yourdomain.com"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ── AUTH TOKENS ─────────────────────────────────────────────────────────────
# Access token lifetime in minutes (default: 15)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token lifetime in days (default: 7)
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── GOOGLE OAUTH ────────────────────────────────────────────────────────────
# Enable Google OAuth authentication (true/false)
GOOGLE_AUTH_ENABLED=false

# Google OAuth 2.0 credentials from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match the "Authorized redirect URI" in Google Cloud Console
# Example: https://your-app.com/auth/google/callback
GOOGLE_REDIRECT_URI=

# ── GITHUB OAUTH ─────────────────────────────────────────────────────────────
# Enable GitHub OAuth authentication (true/false)
GITHUB_AUTH_ENABLED=false

# GitHub OAuth App credentials from https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Must match the "Authorization callback URL" in GitHub App settings
# Example: https://your-app.com/auth/github/callback
GITHUB_REDIRECT_URI=

# ── FRONTEND URL ──────────────────────────────────────────────────────────────
# Base URL of your frontend application (for email verification & password reset links)
FRONTEND_BASE_URL=http://localhost:3000

# ── PAYSTACK BILLING ──────────────────────────────────────────────────────────
# Paystack secret key (from https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=

# Paystack public key (for payment initialization on frontend)
PAYSTACK_PUBLIC_KEY=

# Paystack API base URL (leave default for production)
PAYSTACK_BASE_URL=https://api.paystack.co

# Currency the Paystack merchant account settles in, and therefore the currency
# customers are actually charged in. NGN is the current production value; USD is
# gated on legal/regulatory approval, not on a code change.
PAYSTACK_CURRENCY=NGN

# HMAC-SHA512 signature secret from the Paystack dashboard (Webhooks settings).
# Required in production: an unsigned webhook is refused.
PAYSTACK_WEBHOOK_SECRET=

# What each plan costs in PAYSTACK_CURRENCY, in minor units (kobo for NGN).
# The USD figures are PRODUCT list prices; these are the amounts sent to Paystack
# and the amounts shown beside them. A plan that is not listed here has no
# published price, so self-serve checkout for that plan stays disabled rather
# than charging a made-up amount.
# JSON — flat (monthly only) or per billing interval:
#   PAYSTACK_NGN_PLAN_PRICES={"pro":{"monthly":6000000,"annual":60000000}}
PAYSTACK_NGN_PLAN_PRICES=

# ── ACQUISITION ANALYTICS (optional) ──────────────────────────────────────────
# Visitor country resolution for the admin traffic panel. CDN edge headers
# (Cloudflare / Vercel) take priority; without a token a free ipapi.co
# fallback is used. Results are cached 7 days per hashed visitor IP.
IPINFO_TOKEN=

# ── SUPABASE AUTH (Required) ──────────────────────────────────────────────────
# Accept and verify Supabase Auth JWTs.
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# ── OBJECT STORAGE (Evidence PDF reports) ─────────────────────────────────────
# Supabase Storage via its S3-compatible API — the ONLY supported backend.
# Get these from the Supabase dashboard: Storage → S3 Access Keys.
# NOTE: these are NOT the anon/service-role API keys from Settings → API.
#
#   SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
#   SUPABASE_S3_REGION=<project region, e.g. eu-west-3>
#   SUPABASE_S3_ACCESS_KEY_ID=<s3 access key id>
#   SUPABASE_S3_SECRET_ACCESS_KEY=<s3 secret access key>
#   SUPABASE_S3_BUCKET=<bucket name — created in the dashboard, never by the app>
#
# For local development use a SEPARATE dev bucket, not the production one.
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET=

# ── EMAIL / NOTIFICATIONS ─────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@reliastra.com
SMTP_USE_TLS=false

# Every automated email carries one canonical footer (support address included),
# defined once in app/infrastructure/email_layout.py — deliberately not an env
# var, so the copy cannot drift between environments.

# ── EMAIL VERIFICATION & PASSWORD RESET ────────────────────────────────────
# Email verification token lifetime in minutes (default: 60)
EMAIL_VERIFICATION_EXPIRE_MINUTES=60

# Password reset token lifetime in minutes (default: 15)
PASSWORD_RESET_EXPIRE_MINUTES=15

# ── PARTNER REFERRAL PROGRAM ──────────────────────────────────────────────────
# Canonical public origin used to build partner referral links.
# Links are always {RELIASTRA_PUBLIC_URL}{PARTNER_REFERRAL_PATH_PREFIX}/{code}
RELIASTRA_PUBLIC_URL=https://reliastra.com
PARTNER_REFERRAL_PATH_PREFIX=/r

# Recurring commission rate, as an integer percentage (30 == 30%).
PARTNER_COMMISSION_RATE=30

# Days a commission stays in `pending` before becoming `payable` (default: 30)
PARTNER_COMMISSION_HOLD_DAYS=30

# Minimum payable balance in minor units before payout is allowed (5000 = $50.00)
PARTNER_MINIMUM_PAYOUT_MINOR=5000

# Default ISO-4217 currency for partner money. All amounts are integer minor units.
PARTNER_DEFAULT_CURRENCY=USD

# ── RELIASTRA-MANAGED AI (EVIDENCE EXPLANATIONS) ──────────────────────────────
# The LLM behind AI explanations is operated by Reliastra. Customers never
# register a provider, endpoint, model or key — organizations only opt out via
# PATCH /v1/orgs/current {"ai_explanations_enabled": false}.
#
# Master switch. When false (or when no API key is set), evidence reports are
# generated without an AI explanation section. Attribution is unaffected.
RELIASTRA_AI_ENABLED=true

# The only value that must be supplied — everything below already has a
# production default.
RELIASTRA_AI_API_KEY=

# Wire format of the endpoint: openai_compatible | anthropic | google
RELIASTRA_AI_PROVIDER_TYPE=openai_compatible
RELIASTRA_AI_ENDPOINT_URL=https://api.openai.com/v1/chat/completions
RELIASTRA_AI_MODEL=gpt-4o-mini

# Generation bounds (explanations restate pre-computed facts, so keep these low)
RELIASTRA_AI_MAX_TOKENS=1024
RELIASTRA_AI_TEMPERATURE=0.3
RELIASTRA_AI_TIMEOUT_SECONDS=30

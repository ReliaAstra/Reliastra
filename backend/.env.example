# =============================================================================
# Reliastra Backend - Environment Configuration
# =============================================================================

# ── CORE SERVICES (Required) ──────────────────────────────────────────────────
# Supabase Postgres connection URL with the asyncpg driver (REQUIRED).
# Copy from Supabase → Project Settings → Database.
# Prefer the connection pooler (port 6543) for the API and workers.
# Example:
#   postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres

# PostgreSQL SSL mode. Supabase URLs default to 'require' when this is empty.
# Supported: disable | allow | prefer | require | verify-ca | verify-full.
DATABASE_SSL_MODE=require

# Redis connection URL (REQUIRED for rate limiting, idempotency, Celery, OAuth state).
# Redis is a cache/queue only - application data lives on Supabase.
REDIS_URL=redis://localhost:6379/0

# Cryptographic secret key for JWT signing and Fernet encryption (REQUIRED)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-cryptographically-random-32-char-string

# ── Admin console (dedicated secret credentials) ──────────────────────────
# The admin control plane is NOT reachable through user sign-in. It requires
# these three secrets, configured together. Set ADMIN_USERNAME and
# ADMIN_PASSWORD (>= 16 chars, strong/unique) plus a random ADMIN_TOKEN_SECRET
# (>= 32 chars). Leaving all three empty disables the admin console entirely.
# Generate the token secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=15
ADMIN_REFRESH_TOKEN_EXPIRE_DAYS=1

# Environment name: development | staging | production
ENVIRONMENT=development

# Structured JSON logs (always on in production). Set true to force JSON locally.
LOG_JSON=false

# Celery Beat interval for dispatching due dependency checks (seconds)
CHECK_SCHEDULE_SECONDS=30

# ── Observation topology and incident detection ────────────────────────────────
# How many genuinely independent observation points probe a dependency.
#   single = the deployed reality today: one host, one worker. Incidents are
#            confirmed by a deterministic consecutive-failure rule.
#   multi  = a real fleet of independent points, where confirmation needs
#            agreement between them inside a window.
# Two scheduling labels emitted by ONE worker are not two observation points:
# setting `multi` on a single-host deployment would present one machine's
# opinion as a quorum. Leave this at `single` unless you actually run a fleet.
OBSERVATION_TOPOLOGY=single

# Consecutive failed checks required to open an incident under
# OBSERVATION_TOPOLOGY=single. This is the debounce: 1 reacts to a single
# dropped probe; 2 (default) requires the failure to survive one more check
# interval. Recovery reuses CONSECUTIVE_RECOVERY_CHECKS.
SINGLE_TOPOLOGY_FAILURE_CHECKS=2

# Celery task time limits (seconds)
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_TASK_TIME_LIMIT=300

# ── CORS (Required for frontend integration) ───────────────────────────────────
# Must include your frontend URL(s). The default allows local dev only.
# For production: ["https://yourdomain.com", "https://app.yourdomain.com"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ── AUTH TOKENS ─────────────────────────────────────────────────────────────
# Access token lifetime in minutes (default: 15)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token lifetime in days (default: 7)
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── GOOGLE OAUTH ────────────────────────────────────────────────────────────
# Enable Google OAuth authentication (true/false)
GOOGLE_AUTH_ENABLED=false

# Google OAuth 2.0 credentials from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match the "Authorized redirect URI" in Google Cloud Console
# Example: https://your-app.com/auth/google/callback
GOOGLE_REDIRECT_URI=

# ── GITHUB OAUTH ─────────────────────────────────────────────────────────────
# Enable GitHub OAuth authentication (true/false)
GITHUB_AUTH_ENABLED=false

# GitHub OAuth App credentials from https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Must match the "Authorization callback URL" in GitHub App settings
# Example: https://your-app.com/auth/github/callback
GITHUB_REDIRECT_URI=

# ── FRONTEND URL ──────────────────────────────────────────────────────────────
# Base URL of your frontend application (for email verification & password reset links)
FRONTEND_BASE_URL=http://localhost:3000

# ── PAYSTACK BILLING ──────────────────────────────────────────────────────────
# Paystack secret key (from https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=

# Paystack public key (for payment initialization on frontend)
PAYSTACK_PUBLIC_KEY=

# Paystack API base URL (leave default for production)
PAYSTACK_BASE_URL=https://api.paystack.co

# Currency the Paystack merchant account settles in, and therefore the currency
# customers are actually charged in. NGN is the current production value; USD is
# gated on legal/regulatory approval, not on a code change.
PAYSTACK_CURRENCY=NGN

# HMAC-SHA512 signature secret from the Paystack dashboard (Webhooks settings).
# Required in production: an unsigned webhook is refused.
PAYSTACK_WEBHOOK_SECRET=

# What each plan costs in PAYSTACK_CURRENCY is no longer operator-published:
# the charge is the USD product price converted at the live exchange rate
# fetched from FX_REFERENCE_URL (see below). A plan is chargeable only while a
# rate is available; if the rate fetch fails, self-serve checkout is disabled
# rather than charging a made-up or stale Naira amount.

# ── LIVE EXCHANGE RATE (prices the NGN charge) ──────────────────────────────
# Payment surfaces show a USD→NGN market rate, and that same rate is the basis
# of the charge: round(USD minor units × rate). The number is attributed to a
# verifiable source and timestamped. If the fetch fails the panel is hidden AND
# self-serve checkout refuses to price the charge - it never falls back to a
# fixed or guessed figure.
FX_REFERENCE_ENABLED=true
FX_REFERENCE_URL=https://open.er-api.com/v6/latest/USD

FX_REFERENCE_PROVIDER=ExchangeRate-API
FX_REFERENCE_PROVIDER_URL=https://www.exchangerate-api.com
FX_REFERENCE_CACHE_TTL_SECONDS=3600

# ── ACQUISITION ANALYTICS (optional) ──────────────────────────────────────────
# Visitor country resolution for the admin traffic panel. CDN edge headers
# (Cloudflare / Vercel) take priority; without a token a free ipapi.co
# fallback is used. Results are cached 7 days per hashed visitor IP.
IPINFO_TOKEN=

# Internal traffic is excluded from the admin pageview / unique-visitor
# counters before it is ever recorded. Put the machines that are not visitors
# here - your own laptop, the office egress IP, a staging box. Accepts IPs and
# CIDRs, comma-separated.
# ANALYTICS_EXCLUDE_NETWORKS=
# Non-public client addresses (loopback, RFC1918, CGNAT) are dropped when the
# request reaches the API without an X-Forwarded-For header. Keep this on.
# ANALYTICS_EXCLUDE_INTERNAL_IPS=true
# Path prefixes that never count as a page view, whatever the beacon reports.
# ANALYTICS_EXCLUDE_PATH_PREFIXES=/admin
# First-party cookie the frontend sets for "Exclude this browser". Only rename
# it if the frontend constant is renamed with it.
# ANALYTICS_OPT_OUT_COOKIE=reliastra_analytics_optout

# ── SUPABASE AUTH (Required) ──────────────────────────────────────────────────
# Accept and verify Supabase Auth JWTs.
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# ── OBJECT STORAGE (Evidence PDF reports) ─────────────────────────────────────
# Supabase Storage via its S3-compatible API - the ONLY supported backend.
# Get these from the Supabase dashboard: Storage → S3 Access Keys.
# NOTE: these are NOT the anon/service-role API keys from Settings → API.
#
#   SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
#   SUPABASE_S3_REGION=<project region, e.g. eu-west-3>
#   SUPABASE_S3_ACCESS_KEY_ID=<s3 access key id>
#   SUPABASE_S3_SECRET_ACCESS_KEY=<s3 secret access key>
#   SUPABASE_S3_BUCKET=<bucket name - created in the dashboard, never by the app>
#
# For local development use a SEPARATE dev bucket, not the production one.
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET=

# ── EMAIL / NOTIFICATIONS ─────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@reliastra.com
SMTP_USE_TLS=false

# Every automated email carries one canonical footer (support address included),
# defined once in app/infrastructure/email_layout.py - deliberately not an env
# var, so the copy cannot drift between environments.

# ── EMAIL VERIFICATION & PASSWORD RESET ────────────────────────────────────
# Email verification token lifetime in minutes (default: 60)
EMAIL_VERIFICATION_EXPIRE_MINUTES=60

# Password reset token lifetime in minutes (default: 15)
PASSWORD_RESET_EXPIRE_MINUTES=15

# ── OUTREACH HUNTER (isolated cold-outbound stream) ───────────────────────
# From MUST be on a Resend-verified subdomain (e.g. outreach.reliastra.com).
# Never use the product stream (noreply@/alerts@) for outreach.
# OUTREACH_FROM_EMAIL=Reliastra <hello@outreach.reliastra.com>
# OUTREACH_REPLY_TO=hello@reliastra.com
# Warmup ramp: 5 -> 10 -> 20 -> 35 -> 50. Raise only when bounce<3%,
# complaint<0.1%. Hard ceiling 50 is enforced in code.
# OUTREACH_DAILY_CAP=5
# Comma-separated seed URLs for the daily Beat hunt. Empty = scheduled hunt
# disabled (manual POST /v1/admin/outreach/hunt still works).
# OUTREACH_SEEDS=
# Discovery (free grounds, no API keys). One DuckDuckGo killer query per day
# (built-in care-plan/geo-TLD rotation unless overridden) plus up to 10
# directory listing pages whose outbound links become hunt candidates.
# Everything flows through kill-first + dedup; discovery never sends.
# OUTREACH_DISCOVERY_QUERIES=
# OUTREACH_DISCOVERY_SOURCES=

# ── PARTNER REFERRAL PROGRAM ──────────────────────────────────────────────────
# Canonical public origin used to build partner referral links.
# Links are always {RELIASTRA_PUBLIC_URL}{PARTNER_REFERRAL_PATH_PREFIX}/{code}
RELIASTRA_PUBLIC_URL=https://reliastra.com
PARTNER_REFERRAL_PATH_PREFIX=/r

# Recurring commission rate, as an integer percentage (30 == 30%).
PARTNER_COMMISSION_RATE=30

# Days a commission stays in `pending` before becoming `payable` (default: 30)
PARTNER_COMMISSION_HOLD_DAYS=30

# Minimum payable balance in minor units before payout is allowed (5000 = $50.00)
PARTNER_MINIMUM_PAYOUT_MINOR=5000

# Default ISO-4217 currency for partner money. All amounts are integer minor units.
PARTNER_DEFAULT_CURRENCY=USD

# ── EVIDENCE ARTIFACTS (SIGNING + VERIFICATION LINKS) ─────────────────────────
# What an evidence PDF says about itself. These three decide whether a report is
# a self-describing record or a printout.
#
# Public origin a recipient can open. Printed into the document as the
# verification page and the API record path; empty falls back to
# https://reliastra.com.
SITE_URL=https://reliastra.com
# Override only for a staging or white-label host that must show a different
# address on the same document. Empty = SITE_URL.
EVIDENCE_VERIFICATION_BASE_URL=
# Ed25519 private key that signs the canonical evidence payload: a base64url /
# base64 / hex 32-byte seed, or a PEM block. Generate with:
#   python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import \
#       Ed25519PrivateKey as K; import base64; \
#       print(base64.urlsafe_b64encode(K.generate().private_bytes_raw()).decode())"
# UNSET IS A SUPPORTED STATE: artifacts are issued unsigned and the document says
# so in section 11. Turning this on does not change any hash - only adds a
# signature a third party can check against /api/v1/verify/keys without trusting
# us. Keep the private key out of the frontend, the repository and the logs.
EVIDENCE_SIGNING_PRIVATE_KEY=
# Prefer a mounted file in production so the key never lands in an env dump.
EVIDENCE_SIGNING_PRIVATE_KEY_FILE=
# Stable key identifier, published with the public key. Defaults to the first 16
# hex characters of sha256(public key); set it explicitly BEFORE a rotation so
# references quoted in past correspondence still resolve.
EVIDENCE_KEY_ID=

# ── PUBLIC WEB SURFACES (what reliastra.com publishes) ────────────────────────
# Shared secret the web app sends as X-Reliastra-Reader on its server-side reads
# of /v1/vendors/* - the catalog, every record page, every incident page, and
# the sitemap. The web app renders each of those pages itself, so without this
# that traffic arrives from one socket address and shares a single per-IP
# rate-limit bucket with every browser call it proxies: one crawler walking the
# observatory then 429s the whole site, including the pages the crawler came
# for. Set it and the reader is limited on its own budget instead. Empty means
# the header is ignored and every caller is limited by IP. Must equal the web
# app's RELIASTRA_READER_TOKEN; generate one with:
#   openssl rand -hex 32
INTERNAL_READER_TOKEN=

# How many days of incidents /v1/vendors/{name}/incidents/public returns. This
# is the lifetime of a published URL, not a query tuning knob: every incident in
# the list has a public page of its own, is linked from the vendor record, and
# is listed in sitemap.xml. An incident that ages out of the window therefore
# takes a URL that used to resolve to a 404, so this must not be set below the
# evidence retention the published documents promise
# (DEFAULT_EVIDENCE_EXPIRY_DAYS in app/modules/evidence/constants.py, 365 days).
# It was hard-coded at 90 while the site said the pages were permanent, which is
# how three quarters of the published incident URLs started 404ing.
PUBLIC_INCIDENT_WINDOW_DAYS=365

# ── RELIASTRA-MANAGED AI (EVIDENCE EXPLANATIONS) ──────────────────────────────
# The LLM behind AI explanations is operated by Reliastra. Customers never
# register a provider, endpoint, model or key - organizations only opt out via
# PATCH /v1/orgs/current {"ai_explanations_enabled": false}.
#
# Master switch. When false (or when no API key is set), evidence reports are
# generated without an AI explanation section. Attribution is unaffected.
RELIASTRA_AI_ENABLED=true

# The only value that must be supplied - everything below already has a
# production default.
RELIASTRA_AI_API_KEY=

# Wire format of the endpoint: openai_compatible | anthropic | google
RELIASTRA_AI_PROVIDER_TYPE=openai_compatible
RELIASTRA_AI_ENDPOINT_URL=https://api.openai.com/v1/chat/completions
RELIASTRA_AI_MODEL=gpt-4o-mini

# Generation bounds (explanations restate pre-computed facts, so keep these low)
RELIASTRA_AI_MAX_TOKENS=1024
RELIASTRA_AI_TEMPERATURE=0.3
RELIASTRA_AI_TIMEOUT_SECONDS=30

# Physical deployment region for this worker. Each region requires a worker
# actually deployed there. Workers consume celery + checks.<region>; the
# scheduler routes probes to their requested region, never relabels local work.
CHECK_WORKER_REGION=us-east
